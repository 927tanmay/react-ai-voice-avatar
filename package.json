  "keywords": [
    "react",
    "threejs",
    "r3f",
    "ai-avatar",
    "voice-ai",
    "webgpu",
    "whisper",
    "kokoro",
    "tts",
    "stt",
    "llm",
    "lip-sync",
    "3d-avatar",
    "conversational-ai",
    "local-ai",
    "onnx",
    "virtual-assistant",
    "ai-concierge",
    "hybrid-cloud",
    "openai",
    "claude",
    "llm-integration"
  ],
  "author": "Tanmay <https://github.com/927tanmay>",
  "repository": {
    "type": "git",
    "url": "https://github.com/927tanmay/react-ai-voice-avatar.git"
  },
  "bugs": {
    "url": "https://github.com/927tanmay/react-ai-voice-avatar/issues"
  },
  "homepage": "https://react-ai-voice-avatar.vercel.app/",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
