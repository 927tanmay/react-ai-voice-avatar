      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@react-three/drei": "^9.0.0 || ^10.0.0",
    "@react-three/fiber": "^8.0.0 || ^9.0.0",
    "react": "^18.0.0 || >=19 <20",
    "react-dom": "^18.0.0 || >=19 <20",
    "three": ">=0.156"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@ricky0123/vad-web": "^0.0.30",
    "kokoro-js": "^1.2.1",
    "leva": "^0.10.1",
    "onnxruntime-web": "^1.27.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.167.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.1.3",
    "three": "^0.167.0",
    "typescript": "^5.5.4",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "scripts": {
    "build": "rimraf dist && node scripts/build-workers.mjs && vite build",
